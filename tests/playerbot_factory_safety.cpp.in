constexpr uint16 SKILL_TWO_HANDED_SWORDS = 55, SKILL_DEFENSE = 95, SKILL_STAVES = 136, SKILL_TWO_HANDED_MACES = 160;
constexpr uint16 SKILL_TWO_HANDED_AXES = 172, SKILL_DAGGERS = 173, SKILL_THROWN = 176, SKILL_CROSSBOWS = 226;
constexpr uint16 SKILL_WANDS = 228, SKILL_POLEARMS = 229, SKILL_PLATE_MAIL = 293, SKILL_MAIL = 413;
constexpr uint16 SKILL_FIST_WEAPONS = 473, SKILL_RIDING = 762;
