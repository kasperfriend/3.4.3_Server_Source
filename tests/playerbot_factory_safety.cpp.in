struct DB2Manager
{
    set<uint32> allowed;
    SkillRaceClassInfoEntry const* GetSkillRaceClassInfo(uint32 skill, uint8, uint8) const
    {
        static SkillRaceClassInfoEntry info;
        return allowed.count(skill) ? &info : nullptr;
    }
} db2Manager;
auto& sDB2Manager = db2Manager;
constexpr uint32 PLAYERSPELL_REMOVED = 1, PETSPELL_REMOVED = 1, DIFFICULTY_NONE = 0;
constexpr uint32 ITEM_QUALITY_NORMAL = 1, ITEM_QUALITY_UNCOMMON = 2, ITEM_QUALITY_RARE = 3, ITEM_QUALITY_EPIC = 4;
constexpr uint32 ITEM_CLASS_WEAPON = 2, ITEM_CLASS_ARMOR = 4, ITEM_CLASS_CONTAINER = 1, ITEM_SUBCLASS_ARMOR_SHIELD = 6;
constexpr uint32 BIND_QUEST = 4, BIND_ON_USE = 3, CONFIG_MAX_PLAYER_LEVEL = 0;
constexpr uint32 PLAYER_FLAGS_EX_HIDE_HELM = 1, PLAYER_FLAGS_EX_HIDE_CLOAK = 2;
constexpr uint32 POWER_MANA = 0, POWER_ENERGY = 1, LOCALE_enUS = 0;
constexpr float INVALID_HEIGHT = -100000.0f;
uint32 urand(uint32 lo, uint32 hi) { CHECK(lo <= hi); return lo; }
float frand(float lo, float hi) { CHECK(isfinite(lo) && isfinite(hi) && lo <= hi); return lo; }
array<double, 3> drawnWeights{};
uint32 urandweighted(size_t n, double const* weights)
{
    CHECK(n == 3);
    copy_n(weights, 3, drawnWeights.begin());
    // Pick the last nonzero bucket to exercise the formerly ignored third weight.
    for (int32 i = 2; i >= 0; --i)
        if (weights[i] > 0) return uint32(i);
    throw runtime_error("No nonzero talent weights");
}
struct World { uint32 getIntConfig(uint32) const { return 80; } } world;
auto sWorld = &world;
