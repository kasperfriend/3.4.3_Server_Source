@PET@
@CLEAR_SPELLS@
@PREPARE@
@TALENTS@
@EQUIP@
@SKILLS@
@RANDOM_SKILL@
@REFRESH@
@TELEPORT@
@TELEPORT_LEVEL_GUARD@
    ++queries; // sentinel for spatial work after the entry guards
}
uint32 StartupBudget(int processTicks)
{
@BUDGET@
    return randomBotsPerInterval;
}
void ConsoleRefresh(Player* bot)
{
@CONSOLE_REFRESH@
}

void TestPet()
{
    objectMgr.creatures = { { 11, {} } };
    for (bool unslotted : { false, true })
    {
        Player bot;
        if (unslotted) bot.stable.unslotted = true;
        else bot.stable.CurrentPet = PetStable::PetInfo{ 9 };
        PlayerbotFactory(&bot, 13).InitPet();
        CHECK(bot.creations == 0 && !bot.pet); // never replace a dismissed/loading pet
    }
    {
        Player bot;
        bot.creationFails = true;
        PlayerbotFactory(&bot, 13).InitPet();
        CHECK(bot.creations == 1 && !bot.pet && !bot.stable.CurrentPet);
    }
    {
        Player bot;
        bot.map.allowAdd = false;
        PlayerbotFactory(&bot, 13).InitPet();
        CHECK(bot.creations == 1 && !bot.pet && !bot.stable.CurrentPet && livePets == 0);
    }
    {
        Player bot;
        petCalls.clear();
        PlayerbotFactory(&bot, 13).InitPet();
        CHECK(petCalls == vector<string>({ "tame", "map", "minion", "talents", "save", "spells" }));
        CHECK(bot.pet && bot.stable.CurrentPet && livePets == 1);
        // Existing pets, including non-hunters, must tolerate missing spell data.
        bot.cls = 9;
        bot.pet->m_spells = { { 1, {} }, { 2, {} }, { 999, {} }, { 998, { PETSPELL_REMOVED } } };
        spellMgr.spells = { { 1, { 1, false } }, { 2, { 2, true } } };
        warnings = 0;
        PlayerbotFactory(&bot, 13).InitPet();
        CHECK(bot.pet->autocasts == vector<uint32>({ 1 }) && warnings == 1);
    }
    CHECK(livePets == 0);
    for (uint32 flag = 0; flag < 3; ++flag)
    {
        Player bot;
        if (flag == 0) bot.inWorld = false;
        if (flag == 1) bot.teleporting = true;
        if (flag == 2) bot.positionValid = false;
        PlayerbotFactory(&bot, 13).InitPet();
        CHECK(bot.creations == 0 && !bot.pet);
    }
    objectMgr.creatures.clear();
    Player bot;
    PlayerbotFactory(&bot, 13).InitPet();
    CHECK(!bot.pet);
}
void TestSpellReset()
{
    Player bot;
    bot.spells = { { 1, {} }, { 2, {} }, { 3, {} }, { 999, {} }, { 998, { PLAYERSPELL_REMOVED } }, { 997, { 0, true } } };
    spellMgr.spells = { { 1, { 1, false } }, { 2, { 2, true } }, { 3, { 3, false } } };
    warnings = 0;
    PlayerbotFactory(&bot, 13).ClearSpells();
    CHECK(bot.removed == vector<uint32>({ 1, 3 }) && warnings == 1);
    CHECK(bot.spells.count(2) && bot.spells.count(999));
}
void TestCombatRefresh()
{
    Player bot, otherPlayer;
    Unit enemy, secondEnemy;
    Threaten(enemy, bot);
    Threaten(secondEnemy, bot);
    Threaten(enemy, otherPlayer);
    randomMgr.Refresh(&bot);
    CHECK(bot.threats.refs.empty() && bot.opponents.empty());
    CHECK(enemy.stopped == 0 && secondEnemy.stopped == 0);
    CHECK(enemy.opponents.count(&otherPlayer) && otherPlayer.threats.refs.size() == 1);
    bot.dead = true;
    randomMgr.Refresh(&bot);
    CHECK(!bot.dead && bot.saved == 1);
    randomMgr.Refresh(nullptr);
    bot.hasAI = false;
    randomMgr.Refresh(&bot);
}
void CheckMaximumLevel()
{
    constexpr uint32 MAX_LEVEL = 80;
    for (uint32 limit : { 0u, 1u, 80u, 81u, numeric_limits<uint32>::max() })
    {
        array<uint32, 1> m_int_configs{ limit };
@MAX_LEVEL@
        CHECK(m_int_configs[CONFIG_MAX_PLAYER_LEVEL] >= 1 && m_int_configs[CONFIG_MAX_PLAYER_LEVEL] <= MAX_LEVEL);
    }
}
void TestLevelsTalentsAndEquipment()
{
    Player bot;
    PlayerbotFactory factory(&bot, 13);
    factory.Prepare();
    CHECK(bot.level == 13 && bot.statsLevel == 13);
    bot.GiveLevel(20);
    factory.RestoreLevel();
    CHECK(bot.level == 13 && bot.statsLevel == 13);
    factory.level = 0;
    factory.Prepare();
    CHECK(bot.level == 1 && factory.level == 1 && bot.statsLevel == 1);
    ItemTemplate item;
    CHECK(factory.CanEquipItem(&item, ITEM_QUALITY_UNCOMMON)); // level - delta must not wrap
    factory.level = numeric_limits<uint32>::max();
    factory.Prepare();
    CHECK(bot.level == 80 && factory.level == 80);
    bot.GiveLevel(1);
    ConsoleRefresh(&bot);
    CHECK(bot.level == 1 && bot.statsLevel == 1);
    for (uint32 weight : { 0u, 100u, numeric_limits<uint32>::max() })
    {
        for (auto& value : config.specProbability[bot.cls]) value = weight;
        factory.talents.clear();
        factory.InitTalents();
        CHECK(factory.talents == vector<uint32>({ 2 }));
        CHECK(drawnWeights == array<double, 3>({ double(weight ? weight : 1), double(weight ? weight : 1), double(weight ? weight : 1) }));
    }
    bot.cls = 255;
    factory.talents.clear();
    factory.InitTalents();
    CHECK(factory.talents.empty());
    config.minRandomBotsPerInterval = config.maxRandomBotsPerInterval = numeric_limits<uint32>::max();
    CHECK(StartupBudget(0) == 100 && StartupBudget(10) == numeric_limits<uint32>::max());
    config.minRandomBotsPerInterval = config.maxRandomBotsPerInterval = 0;
    CHECK(StartupBudget(0) == 0);
}
void TestSkills()
{
    sDB2Manager.allowed = { SKILL_DEFENSE, SKILL_BOWS, SKILL_GUNS, SKILL_MAIL, SKILL_RIDING };
    Player hunter;
    hunter.cls = CLASS_HUNTER;
    hunter.level = 40;
    PlayerbotFactory(&hunter, 40).InitSkills();
    set<uint32> written(hunter.skills.begin(), hunter.skills.end());
    CHECK(written.count(SKILL_DEFENSE) && written.count(SKILL_BOWS) && written.count(SKILL_GUNS));
    CHECK(written.count(SKILL_MAIL) && written.count(SKILL_RIDING));
    CHECK(!written.count(SKILL_SWORDS) && !written.count(SKILL_WANDS) && !written.count(SKILL_PLATE_MAIL));
    hunter.skills.clear();
    sDB2Manager.allowed.clear();
    PlayerbotFactory(&hunter, 40).InitSkills();
    CHECK(hunter.skills.empty()); // no SkillRaceClassInfo, no character_skills rows
    sDB2Manager.allowed = { SKILL_DEFENSE, SKILL_SWORDS, SKILL_PLATE_MAIL, SKILL_RIDING };
    Player warrior;
    warrior.cls = CLASS_WARRIOR;
    warrior.level = 80;
    PlayerbotFactory(&warrior, 80).InitSkills();
    set<uint32> warriorSkills(warrior.skills.begin(), warrior.skills.end());
    CHECK(warriorSkills.count(SKILL_SWORDS) && warriorSkills.count(SKILL_PLATE_MAIL) && warriorSkills.count(SKILL_RIDING));
    CHECK(!warriorSkills.count(SKILL_BOWS) && !warriorSkills.count(SKILL_MAIL));
}
void TestTeleport()
{
    Player bot;
    vector<WorldLocation> locations{ {} };
    config.randomBotMaps.clear();
    uint32 queries = randomMgr.queries;
    randomMgr.RandomTeleportForLevel(&bot);
    CHECK(randomMgr.queries == queries); // empty maps stop scheduled spatial work
    config.randomBotMaps = { 0 };
    bot.teleporting = true;
    randomMgr.RandomTeleport(&bot, locations);
    randomMgr.RandomTeleportForLevel(&bot);
    CHECK(bot.teleports == 0 && randomMgr.queries == queries);
    bot.teleporting = false;
    locations[0].map = 33;
    randomMgr.RandomTeleport(&bot, locations);
    CHECK(bot.teleports == 0);
    locations[0].map = 999;
    randomMgr.RandomTeleport(&bot, locations);
    CHECK(bot.teleports == 0);
    locations[0].map = 0;
    locations[0].m_positionX = numeric_limits<float>::quiet_NaN();
    randomMgr.RandomTeleport(&bot, locations);
    CHECK(bot.teleports == 0);
    locations[0].m_positionX = 0;
    bot.map.height = numeric_limits<float>::quiet_NaN();
    randomMgr.RandomTeleport(&bot, locations);
    CHECK(bot.teleports == 0);
    bot.map.height = 10;
    for (float distance : { -1.0f, 0.0f, numeric_limits<float>::infinity() })
    {
        config.grindDistance = distance;
        randomMgr.RandomTeleport(&bot, locations);
    }
    CHECK(bot.teleports == 3);
    randomMgr.RandomTeleport(&bot, locations);
    CHECK(bot.teleports == 4); // dest mmap is not a teleport gate; terrain/area already passed
}
int main()
{
    try
    {
        CheckMaximumLevel(); TestPet(); TestSpellReset(); TestCombatRefresh(); TestLevelsTalentsAndEquipment(); TestSkills(); TestTeleport();
        cout << "Factory/pet/spell/combat/skill/teleport regressions passed\n";
    }
    catch (exception const& error) { cerr << error.what() << '\n'; return 1; }
}
