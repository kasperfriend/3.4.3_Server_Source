struct SpellInfo { uint32 Id; bool passive = false; bool IsPassive() const { return passive; } };
struct SpellState { uint32 state = 0; bool disabled = false; };
using PlayerSpellMap = map<uint32, SpellState>;
using PetSpellMap = PlayerSpellMap;
struct SpellMgr
{
    map<uint32, SpellInfo> spells;
    SpellInfo const* GetSpellInfo(uint32 id, uint32) const
    {
        auto it = spells.find(id);
        return it == spells.end() ? nullptr : &it->second;
    }
} spellMgr;
auto sSpellMgr = &spellMgr;
struct Pet;
struct Player;
struct Unit;
struct ThreatReference { Unit* owner; Unit* GetOwner() const { return owner; } };
struct ThreatMgr
{
    map<uint32, unique_ptr<ThreatReference>> refs;
    auto const& GetThreatenedByMeList() const { return refs; }
    void ClearAllThreat() { refs.clear(); }
    void RemoveMeFromThreatLists() { refs.clear(); }
};
struct Unit
{
    static uint32 nextId;
    uint32 id = ++nextId, stopped = 0, attackersRemoved = 0;
    set<Unit*> opponents;
    ThreatMgr threats;
    ThreatMgr& GetThreatManager() { return threats; }
    void RemoveAllAttackers() { ++attackersRemoved; }
    void CombatStop(bool)
    {
        ++stopped;
        for (Unit* opponent : opponents)
        {
            opponent->opponents.erase(this);
            // This matches the core's CombatReference::EndCombat side effect.
            opponent->threats.refs.erase(id);
        }
        opponents.clear();
        threats.refs.clear();
    }
};
uint32 Unit::nextId = 0;
void Threaten(Unit& enemy, Unit& target)
{
    target.threats.refs[enemy.id] = make_unique<ThreatReference>(ThreatReference{ &enemy });
    enemy.opponents.insert(&target);
    target.opponents.insert(&enemy);
}
struct PetStable
{
    struct PetInfo { uint32 PetNumber; };
    optional<PetInfo> CurrentPet;
    bool unslotted = false;
    PetInfo const* GetUnslottedHunterPet() const { static PetInfo info{ 9 }; return unslotted ? &info : nullptr; }
};
struct Charm { uint32 number = 0; uint32 GetPetNumber() const { return number; } };
vector<string> petCalls;
int livePets = 0;
struct Pet
{
    Player* owner;
    uint32 entry = 11;
    PetSpellMap m_spells;
    vector<uint32> autocasts;
    Charm charm;
    explicit Pet(Player* player, uint32 = HUNTER_PET) : owner(player) { ++livePets; }
    ~Pet() { --livePets; }
    Pet* ToCreature() { return this; }
    uint32 GetEntry() const { return entry; }
    Charm* GetCharmInfo() { return &charm; }
    void InitTalentForLevel() { petCalls.push_back("talents"); }
    void SavePetToDB(uint32);
    void ToggleAutocast(SpellInfo const* info, bool) { CHECK(info); autocasts.push_back(info->Id); }
};
struct Map
{
    bool allowAdd = true;
    void* GetTerrain() { return nullptr; }
    uint32 GetInstanceId() const { return 0; }
    float height = 10.0f;
    bool AddToMap(Pet*) { petCalls.push_back("map"); return allowAdd; }
    bool IsInWater(uint32, float, float, float) const { return false; }
    uint32 GetAreaId(uint32, float, float, float) const { return 1; }
    float GetHeight(uint32, float, float, float) const { return height; }
};
struct AI { uint32 resets = 0; void Reset() { ++resets; } void ResetStrategies() { ++resets; } };
struct Motion { void Clear() { } };
struct Guid { string ToString() const { return "Player-1-test"; } };
struct Player : Unit
{
    uint8 cls = CLASS_HUNTER, race = 1, level = 1, statsLevel = 1;
    vector<uint32> skills;
    bool inWorld = true, teleporting = false, positionValid = true, hasAI = true, dead = false, creationFails = false;
    uint32 creations = 0, saved = 0, teleports = 0;
    PlayerSpellMap spells;
    vector<uint32> removed;
    Pet* pet = nullptr;
    PetStable stable;
    Map map;
    AI ai;
    Motion motion;
    ~Player() { delete pet; }
    uint8 GetClass() const { return cls; }
    uint8 GetRace() const { return race; }
    uint8 GetLevel() const { return level; }
    void SetSkill(uint32 id, uint16, uint16, uint16) { skills.push_back(id); }
    void SetLevel(uint8 value) { level = value; }
    void GiveLevel(uint8 value) { CHECK(value >= 1 && value <= 80); level = statsLevel = value; }
    string GetName() const { return "testbot"; }
    Guid GetGUID() const { return {}; }
    Map* GetMap() { return &map; }
    Pet* GetPet() { return pet; }
    PetStable* GetPetStable() { return &stable; }
    bool IsInWorld() const { return inWorld; }
    bool IsBeingTeleported() const { return teleporting; }
    bool IsPositionValid() const { return positionValid; }
    Pet* CreateTamedPetFrom(uint32 entry, uint32)
    {
        ++creations;
        CHECK(!stable.CurrentPet && !stable.GetUnslottedHunterPet());
        if (creationFails) return nullptr;
        petCalls.push_back("tame");
        auto created = new Pet(this);
        created->entry = entry;
        created->charm.number = 77;
        stable.CurrentPet = PetStable::PetInfo{ 77 };
        return created;
    }
    void SetMinion(Pet* value, bool) { petCalls.push_back("minion"); pet = value; }
    void PetSpellInitialize() { petCalls.push_back("spells"); }
    PlayerSpellMap& GetSpellMap() { return spells; }
    void RemoveSpell(uint32 spell, bool, bool)
    {
        removed.push_back(spell);
        spells.erase(spell); // clearing the spellbook must iterate a snapshot
    }
    AI* GetPlayerbotAI() { return hasAI ? &ai : nullptr; }
    bool isDead() const { return dead; }
    void ResurrectPlayer(float, bool = true) { dead = false; }
    void SpawnCorpseBones() { }
    void SaveToDB() { ++saved; }
    void DurabilityRepairAll(bool, float, bool) { }
    void SetFullHealth() { }
    void SetPvP(bool) { }
    uint32 GetMaxPower(uint32) const { return 100; }
    void SetPower(uint32, uint32) { }
    void SetPlayerFlagEx(uint32) { }
    Motion* GetMotionMaster() { return &motion; }
    uint32 GetPhaseShift() const { return 0; }
    bool TeleportTo(uint32, float, float, float, float) { ++teleports; return true; }
};
void Pet::SavePetToDB(uint32)
{
    CHECK(owner->stable.CurrentPet && owner->stable.CurrentPet->PetNumber == charm.number);
    petCalls.push_back("save");
}
