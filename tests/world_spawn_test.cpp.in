// Production world-spawn selection and level normalization against data fakes.
#include <algorithm>
#include <cmath>
#include <cstdint>
#include <iostream>
#include <limits>
#include <map>
#include <set>
#include <stdexcept>
#include <string>
#include <tuple>
#include <vector>
using namespace std;
using uint8 = uint8_t;
using uint16 = uint16_t;
using uint32 = uint32_t;
using uint64 = uint64_t;
using int32 = int32_t;
using int64 = int64_t;
#define CHECK(...) do { if (!(__VA_ARGS__)) throw runtime_error("Check failed at line " + to_string(__LINE__) + ": " #__VA_ARGS__); } while (false)
template<typename... T> void Log(T const&...) { }
#define TC_LOG_INFO(...) Log(__VA_ARGS__)
#define TC_LOG_ERROR(...) Log(__VA_ARGS__)
constexpr uint32 DIFFICULTY_NONE = 0, CONFIG_MAX_PLAYER_LEVEL = 0;
namespace Trinity
{
    bool IsValidMapCoord(float x, float y) { return isfinite(x) && isfinite(y) && abs(x) < 17066 && abs(y) < 17066; }
}
struct Position
{
    float x = 0, y = 0, z = 0;
    float GetPositionX() const { return x; }
    float GetPositionY() const { return y; }
    float GetPositionZ() const { return z; }
    bool IsPositionValid() const { return Trinity::IsValidMapCoord(x, y) && isfinite(z) && abs(z) < 17066; }
};
struct WorldLocation : Position
{
    uint32 mapId = 0;
    WorldLocation(uint32 map, Position const& pos) : Position(pos), mapId(map) { }
};
struct ObjectGuid { using LowType = uint64; };
struct CreatureData
{
    uint32 mapId = 0, id = 1, phaseId = 0, phaseGroup = 0;
    int32 terrainSwapMap = -1;
    Position spawnPoint;
};
struct CreatureDifficulty { uint8 MinLevel = 1, MaxLevel = 1; };
struct CreatureTemplate
{
    CreatureDifficulty difficulty;
    CreatureDifficulty const* GetDifficulty(uint32) const { return &difficulty; }
};
struct CellObjectGuids { set<uint64> creatures; };
using CellObjectGuidsMap = map<uint32, CellObjectGuids>;
struct ObjectMgr
{
    map<uint32, CellObjectGuidsMap> grids;
    map<uint64, CreatureData> spawns;
    map<uint32, CreatureTemplate> templates;
    CellObjectGuidsMap const* GetMapObjectGuids(uint32 mapId, uint32 difficulty)
    {
        CHECK(difficulty == DIFFICULTY_NONE);
        auto it = grids.find(mapId);
        return it == grids.end() ? nullptr : &it->second;
    }
    CreatureData const* GetCreatureData(uint64 id)
    {
        auto it = spawns.find(id);
        return it == spawns.end() ? nullptr : &it->second;
    }
    CreatureTemplate const* GetCreatureTemplate(uint32 id)
    {
        auto it = templates.find(id);
        return it == templates.end() ? nullptr : &it->second;
    }
} objectMgr;
auto sObjectMgr = &objectMgr;
struct MapEntry { bool instance = false; bool Instanceable() const { return instance; } };
struct MapStore
{
    map<uint32, MapEntry> maps{ { 0, {} }, { 1, {} }, { 33, { true } } };
    MapEntry const* LookupEntry(uint32 id)
    {
        auto it = maps.find(id);
        return it == maps.end() ? nullptr : &it->second;
    }
} sMapStore;
struct World { uint32 getIntConfig(uint32) const { return 80; } } world;
auto sWorld = &world;
struct Config { uint32 randomBotTeleportDistance = 1000; } sPlayerbotAIConfig;
uint32 lastMin = 0, lastMax = 0;
uint32 urand(uint32 lo, uint32 hi) { CHECK(lo <= hi); lastMin = lo; lastMax = hi; return lo; }
struct RandomPlayerbotMgr { uint32 GetZoneLevel(uint16 mapId, float x, float y, float z); };
@WORLD_DATA@
@ZONE_LEVEL@

void CheckLevels(int64 low, int64 high, uint8 expectedLow, uint8 expectedHigh)
{
    struct Field { int64 value; int64 GetInt64() const { return value; } } fields[4]{ {}, {}, { low }, { high } };
    uint32 entry = 1, difficulty = 0;
    CreatureDifficulty creatureDifficulty;
@LEVEL_READS@
@LEVEL_ORDER@
    CHECK(creatureDifficulty.MinLevel == expectedLow && creatureDifficulty.MaxLevel == expectedHigh);
}

int main()
{
    try
    {
        objectMgr.templates[1].difficulty = { 10, 12 };
        objectMgr.templates[2].difficulty = { 14, 16 };
        for (uint64 id = 1; id <= 8; ++id)
        {
            objectMgr.spawns[id] = CreatureData{};
            objectMgr.grids[0][0].creatures.insert(id);
        }
        objectMgr.spawns[2].id = 2;
        objectMgr.spawns[2].spawnPoint = { 100, 100, 0 };
        objectMgr.spawns[3].id = 999; // missing template
        objectMgr.spawns[4].phaseId = 12;
        objectMgr.spawns[5].phaseGroup = 17;
        objectMgr.spawns[6].terrainSwapMap = 1;
        objectMgr.spawns[7].spawnPoint.x = numeric_limits<float>::quiet_NaN();
        objectMgr.spawns[8].mapId = 1; // wrong map in stale grid
        objectMgr.grids[0][0].creatures.insert(9); // stale/missing spawn
        objectMgr.spawns[10] = CreatureData{}; // exists but is not registered for normal difficulty
        auto spawns = BuildBotWorldSpawns(0);
        CHECK(spawns.size() == 2);
        CHECK(BuildBotWorldSpawns(1).empty() && BuildBotWorldSpawns(33).empty() && BuildBotWorldSpawns(999).empty());
        CHECK(GetBotWorldSpawns(0).size() == 2 && GetBotWorldSpawns(0).size() == 2);
        RandomPlayerbotMgr mgr;
        CHECK(mgr.GetZoneLevel(0, 0, 0, 0) == 12 && lastMax == 14);
        mgr.GetZoneLevel(0, 5000, 5000, 0);
        CHECK(lastMin == 1 && lastMax == 80);
        CHECK(mgr.GetZoneLevel(0, numeric_limits<float>::infinity(), 0, 0) == 1);

        vector<BotWorldSpawn> nearby{ { WorldLocation(0, {}), 10, 10 }, { WorldLocation(0, { 1, 0, 0 }), 80, 80 } };
        vector<WorldLocation> locations;
        AddBotLevelLocations(nearby, 13, 3, 50.0f, locations);
        CHECK(locations.empty()); // high-level neighbour prevents a dangerous teleport
        nearby[1].minLevel = nearby[1].maxLevel = 1;
        AddBotLevelLocations(nearby, 13, 3, 50.0f, locations);
        CHECK(locations.size() == 1); // a harmless lower-level neighbour does not block it
        locations.clear();
        nearby[0].location.x = -0.05f;
        nearby[1].location.x = 0.05f;
        nearby[1].minLevel = 12;
        nearby[1].maxLevel = 80;
        AddBotLevelLocations(nearby, 13, 3, 0.25f, locations);
        CHECK(locations.empty()); // grid boundary + full level range (not just AVG)
        nearby[1].location.x = 1000;
        AddBotLevelLocations(nearby, 13, 3, 1.0e-38f, locations);
        CHECK(locations.size() == 1);
        locations.clear();
        AddBotLevelLocations(nearby, 13, numeric_limits<uint32>::max(), 50.0f, locations);
        CHECK(locations.size() == 1);

        CheckLevels(0, 0, 1, 1);
        CheckLevels(-2, 300, 1, 255);
        CheckLevels(15, 10, 15, 15);
        CheckLevels(10, 15, 10, 15);
        CheckLevels(numeric_limits<int32>::max(), numeric_limits<int32>::max(), 255, 255);
        cout << "World-spawn/grid selection and level normalization passed\n";
    }
    catch (exception const& error) { cerr << error.what() << '\n'; return 1; }
}
